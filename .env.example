# =============================================================================
# SyncOps — production environment template
# Copy to .env on the VPS:  cp .env.example .env
# NEVER commit .env
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3001
HOSTNAME=0.0.0.0

# --- Supabase (hosted — no local Postgres container) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: only for one-off migration scripts (not required by the web container)
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Cloudinary (server-only — blog/admin image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Admin panel (/admin) ---
# Generate a long random secret, e.g.: openssl rand -hex 32
ADMIN_PASSWORD=change_me_to_a_strong_password
ADMIN_SESSION_SECRET=change_me_to_a_long_random_hex_secret

# --- Optional: Google reCAPTCHA (contact / CTA forms) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
